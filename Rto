ApplyAvatarBtn.MouseButton1Click:Connect(function()
    local rawName = UsernameBox.Text
    local cleanName = string.gsub(rawName, "@", "") -- ตัดเครื่องหมาย @ ออก
    cleanName = string.gsub(cleanName, "%s+", "") -- ตัดช่องว่างออก

    if cleanName == "" then return end
    ApplyAvatarBtn.Text = "กำลังโหลด..."

    local success, userId = pcall(function()
        return Players:GetUserIdFromNameAsync(cleanName)
    end)

    if success and userId then
        local descSuccess, humDesc = pcall(function()
            return Players:GetHumanoidDescriptionFromUserId(userId)
        end)

        if descSuccess and humDesc and LocalPlayer.Character then
            local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
            if hum then
                -- ลบเสื้อผ้าและเครื่องประดับเดิมก่อนสวมชุดใหม่
                for _, v in pairs(LocalPlayer.Character:GetChildren()) do
                    if v:IsA("Accessory") or v:IsA("Shirt") or v:IsA("Pants") or v:IsA("ShirtGraphic") then
                        v:Destroy()
                    end
                end
                hum:ApplyDescription(humDesc)
                ApplyAvatarBtn.Text = "สำเร็จ!"
            end
        else
            ApplyAvatarBtn.Text = "ผิดพลาด"
        end
    else
        ApplyAvatarBtn.Text = "ไม่พบชื่อนี้"
    end
    task.wait(1.5)
    ApplyAvatarBtn.Text = "ตกลง"
end)

