-- [ฟังก์ชัน 1] เร่งสปีดเฉพาะตอนกระโดดแล้วเดิน (Bunny Hop / CNP Style)
local JumpSpeedEnabled = false
local JumpBoostSpeed = 48 -- ปรับความเร็วตอนลอยกลางอากาศได้ที่นี่

CreateButton("เร่งสปีดตอนกระโดด (CNP Speed): ปิด", function(btn)
    JumpSpeedEnabled = not JumpSpeedEnabled
    if JumpSpeedEnabled then
        btn.Text = "เร่งสปีดตอนกระโดด (CNP Speed): เปิด"
        btn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        btn.TextColor3 = Color3.fromRGB(0, 0, 0)
    else
        btn.Text = "เร่งสปีดตอนกระโดด (CNP Speed): ปิด"
        btn.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    end
end)

RunService.Heartbeat:Connect(function()
    if JumpSpeedEnabled then
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local root = char and char:FindFirstChild("HumanoidRootPart")
        
        if hum and root then
            local state = hum:GetState()
            -- เช็คว่าตัวละครกำลังลอย (กระโดด หรือ กำลังร่วง) และมีการกดเดิน (MoveDirection > 0)
            if (state == Enum.HumanoidStateType.Jumping or state == Enum.HumanoidStateType.Freefall) and hum.MoveDirection.Magnitude > 0 then
                root.Velocity = Vector3.new(
                    hum.MoveDirection.X * JumpBoostSpeed,
                    root.Velocity.Y,
                    hum.MoveDirection.Z * JumpBoostSpeed
                )
            end
        end
    end
end)

-- [ฟังก์ชัน 2] เสกไอเทมบินได้ (ถือไอเทมแล้วกดคลิกค้างหรือกดใช้เพื่อบิน)
local Flying = false
local FlySpeed = 60

CreateButton("รับไอเทมบิน (Fly Item)", function(btn)
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if not backpack then return end
    if backpack:FindFirstChild("MagicFlyWand") or (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("MagicFlyWand")) then
        btn.Text = "คุณมีไอเทมบินอยู่ในกระเป๋าแล้ว!"
        task.wait(1.5)
        btn.Text = "รับไอเทมบิน (Fly Item)"
        return
    end

    -- สร้าง Tool จำลองขึ้นมาในกระเป๋า
    local tool = Instance.new("Tool")
    tool.Name = "MagicFlyWand"
    tool.RequiresHandle = true

    local handle = Instance.new("Part")
    handle.Name = "Handle"
    handle.Size = Vector3.new(0.6, 0.6, 2.5)
    handle.Color = Color3.fromRGB(255, 255, 255)
    handle.Material = Enum.Material.Neon
    handle.Parent = tool

    local bv, bg
    tool.Equipped:Connect(function()
        Flying = true
        local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if root then
            bv = Instance.new("BodyVelocity")
            bv.MaxForce = Vector3.new(9e9, 9e9, 9e9)
            bv.Velocity = Vector3.new(0, 0, 0)
            bv.Parent = root

            bg = Instance.new("BodyGyro")
            bg.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
            bg.P = 9e4
            bg.Parent = root

            task.spawn(function()
                while Flying and root and bv and bg do
                    RunService.RenderStepped:Wait()
                    local cam = workspace.CurrentCamera
                    local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
                    bg.CFrame = cam.CFrame
                    if hum and hum.MoveDirection.Magnitude > 0 then
                        bv.Velocity = cam.CFrame.LookVector * FlySpeed
                    else
                        bv.Velocity = Vector3.new(0, 0.1, 0) -- ลอยนิ่งกลางอากาศ
                    end
                end
            end)
        end
    end)

    tool.Unequipped:Connect(function()
        Flying = false
        if bv then bv:Destroy() end
        if bg then bg:Destroy() end
    end)

    tool.Parent = backpack
    btn.Text = "เสกไอเทมสำเร็จ! (ดูในช่องเก็บของ)"
    task.wait(2)
    btn.Text = "รับไอเทมบิน (Fly Item)"
end)

